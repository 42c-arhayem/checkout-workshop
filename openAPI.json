{
    "openapi": "3.0.2",
    "info": {
        "title": "42C Bank API",
        "version": "0.1"
    },
    "servers": [
        {
            "url": "http://localhost:3000/apis"
        },
        {
            "url": "https://api.server.test/apis/banking/v0.1"
        }
    ],
    "components": {
        "schemas": {
            "Utility": {
                "type": "object",
                "properties": {
                    "payeeType": {
                        "type": "string",
                        "enum": [
                            "utility",
                            "contact"
                        ]
                    },
                    "name": {
                        "type": "string"
                    },
                    "utility": {
                        "type": "string",
                        "enum": [
                            "electric",
                            "gas",
                            "mobile"
                        ]
                    },
                    "accountNumber": {
                        "type": "string"
                    }
                }
            },
            "Contact": {
                "type": "object",
                "properties": {
                    "payeeType": {
                        "type": "string",
                        "enum": [
                            "utility",
                            "contact"
                        ]
                    },
                    "name": {
                        "type": "string"
                    },
                    "iban": {
                        "type": "string"
                    }
                }
            },
            "AccountId": {
                "description": "A unique and immutable identifier used to identify the account resource. This identifier has no meaning to the account owner.",
                "type": "string",
                "minLength": 1,
                "maxLength": 40
            },
            "Account": {
                "type": "object",
                "properties": {
                    "AccountId": {
                        "$ref": "#/components/schemas/AccountId"
                    },
                    "Currency": {
                        "type": "string",
                        "pattern": "^[A-Z]{3,3}$"
                    },
                    "AccountType": {
                        "type": "string",
                        "enum": [
                            "Business",
                            "Personal"
                        ]
                    },
                    "Nickname": {
                        "description": "The nickname of the account, assigned by the account owner in order to provide an additional means of identification of the account.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 70
                    }
                }
            }
        },
        "parameters": {
            "AccountId": {
                "name": "AccountId",
                "in": "path",
                "required": true,
                "description": "AccountId",
                "schema": {
                    "type": "string"
                }
            },
            "CardApplicationId": {
                "name": "CardApplicationId",
                "in": "path",
                "required": true,
                "description": "Card Application Id",
                "schema": {
                    "type": "string"
                }
            }
        },
        "securitySchemes": {
            "AccessToken": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    },
    "paths": {
