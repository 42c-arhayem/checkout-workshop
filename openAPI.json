{
    "openapi": "3.0.2",
    "info": {
        "title": "42C Bank API",
        "version": "0.1"
    },
    "servers": [
        {
            "url": "http://localhost:3000/apis/banking"
        },
        {
            "url": "https://api.server.test/apis/banking/v1"
        }
    ],
    "components": {
        "schemas": {
            "Utility": {
                "type": "object",
                "properties": {
                    "payeeType": {
                        "type": "string",
                        "enum": [
                            "utility",
                            "contact"
                        ]
                    },
                    "name": {
                        "type": "string"
                    },
                    "utility": {
                        "type": "string",
                        "enum": [
                            "electric",
                            "gas",
                            "mobile"
                        ]
                    },
                    "accountNumber": {
                        "type": "string"
                    }
                }
            },
            "Contact": {
                "type": "object",
                "properties": {
                    "payeeType": {
                        "type": "string",
                        "enum": [
                            "utility",
                            "contact"
                        ]
                    },
                    "name": {
                        "type": "string"
                    },
                    "iban": {
                        "type": "string"
                    }
                }
            },
            "AccountId": {
                "description": "A unique and immutable identifier used to identify the account resource. This identifier has no meaning to the account owner.",
                "type": "string",
                "minLength": 1,
                "maxLength": 40
            },
            "Account": {
                "type": "object",
                "properties": {
                    "AccountId": {
                        "$ref": "#/components/schemas/AccountId"
                    },
                    "Currency": {
                        "type": "string",
                        "pattern": "^[A-Z]{3,3}$"
                    },
                    "AccountType": {
                        "type": "string",
                        "enum": [
                            "Business",
                            "Personal"
                        ]
                    },
                    "Nickname": {
                        "description": "The nickname of the account, assigned by the account owner in order to provide an additional means of identification of the account.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 70
                    }
                }
            }
        },
        "parameters": {
            "AccountId": {
                "name": "AccountId",
                "in": "path",
                "required": true,
                "description": "AccountId",
                "schema": {
                    "type": "string"
                }
            },
            "CardApplicationId": {
                "name": "CardApplicationId",
                "in": "path",
                "required": true,
                "description": "Card Application Id",
                "schema": {
                    "type": "string"
                }
            }
        },
        "securitySchemes": {
            "AccessToken": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    },
    "paths": {
        "/auth/register": {
            "post": {
                "description": "Register an account",
                "operationId": "CreateAccount",
                "parameters": [],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "description": "your name",
                                        "example": "Joe Smith"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "jsmith@email.com"
                                    },
                                    "postalAddress": {
                                        "description": "Postal address.",
                                        "type": "object",
                                        "properties": {
                                            "addressLine": {
                                                "items": {
                                                    "type": "string",
                                                    "minLength": 1,
                                                    "maxLength": 70
                                                },
                                                "type": "array",
                                                "description": "Information that locates and identifies a specific address, as defined by postal services, that is presented in free format text.",
                                                "minItems": 0,
                                                "maxItems": 5
                                            },
                                            "postCode": {
                                                "description": "Identifier consisting of a group of letters and/or numbers that is added to a postal address to assist the sorting of mail.",
                                                "type": "string",
                                                "minLength": 1,
                                                "maxLength": 16
                                            },
                                            "country": {
                                                "description": "Nation with its own government, occupying a particular territory.",
                                                "type": "string",
                                                "pattern": "^[A-Z]{2,2}$"
                                            }
                                        },
                                        "required": [
                                            "country"
                                        ]
                                    },
                                    "pan": {
                                        "type": "number",
                                        "description": "secret personal account number",
                                        "pattern": "^[0-9]{5,5}$"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "description": "",
                "parameters": [],
                "security": [],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "jsmith@email.com"
                                    },
                                    "pin": {
                                        "type": "string",
                                        "example": "12345"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "access": {
                                            "type": "string"
                                        },
                                        "access_expires": {
                                            "type": "integer"
                                        },
                                        "refresh": {
                                            "type": "string"
                                        },
                                        "refresh_expires": {
                                            "type": "integer"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/account": {
            "get": {
                "description": "Get account information",
                "operationId": "GetAccount",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/AccountId"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            },
            "delete": {
                "description": "Delete an Account",
                "operationId": "DeleteAccount",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/AccountId"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/account/balances": {
            "get": {
                "description": "Get Account balances",
                "operationId": "GetAccountBalances",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/AccountId"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/account/direct-debits": {
            "get": {
                "description": "Get Account Direct Debits",
                "operationId": "GetAccountDD",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/AccountId"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/account/transactions": {
            "get": {
                "description": "Get Account Transactions",
                "operationId": "GetAccountTransactions",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/AccountId"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/account/products/cards": {
            "post": {
                "description": "Create a credit card application",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/AccountId"
                    }
                ],
                "requestBody":{
                    "content": {
                        "application/json":{
                            "schema":{
                                "type": "object",
                                "properties": {
                                    "deliveryMethod":{
                                        "type": "string",
                                        "enum": ["post", "collect"]
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/account/products/cards/{CardApplicationId}": {
            "get": {
                "description": "Get a credit card application",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/AccountId"
                    },
                    {
                        "$ref": "#/components/parameters/CardApplicationId"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            },
            "put": {
                "description": "",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/AccountId"
                    },
                    {
                        "$ref": "#/components/parameters/CardApplicationId"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            },
            "delete": {
                "description": "",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/AccountId"
                    },
                    {
                        "$ref": "#/components/parameters/CardApplicationId"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/account/payees": {
            "get": {
                "description": "Get list of payees",
                "operationId": "GetAccountPayees",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/AccountId"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            },
            "post": {
                "description": "Add new payee",
                "operationId": "CreatePayee",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/AccountId"
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "oneOf": [
                                    {
                                        "$ref": "#/components/schemas/Utility"
                                    },
                                    {
                                        "$ref": "#/components/schemas/Contact"
                                    }
                                ],
                                "discriminator": {
                                    "propertyName": "payeeType"
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/account/payees/{PayeeId}": {
            "delete": {
                "description": "",
                "parameters": [],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/account/payments": {
            "post": {
                "description": "Create a payment to make a transfer or pay a bill.",
                "parameters": [],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "payeeId": {
                                        "type": "string"
                                    },
                                    "amount": {
                                        "type": "number"
                                    },
                                    "currency": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "transactionId": {
                                            "type": "string"
                                        },
                                        "message": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "security": [
        {
            "AccessToken": []
        }
    ]
}