                                        "example": "12345"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "access": {
                                            "type": "string"
                                        },
                                        "access_expires": {
                                            "type": "integer"
                                        },
                                        "refresh": {
                                            "type": "string"
                                        },
                                        "refresh_expires": {
                                            "type": "integer"
                                        }
                                    }
                                }
                            }
                        }
