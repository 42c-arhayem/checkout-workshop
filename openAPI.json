                                        "description": "your name",
                                        "example": "Joe Smith"
                                    },
                                    "email":{
                                        "type": "string",
                                        "example": "jsmith@email.com"
                                    },
                                    "postcode": {
                                        "type": "string",
                                        "example": "A65F4E2"
                                    },
                                    "pin": {
                                        "type": "number",
                                        "description": "default secret pin number",
                                        "pattern": "^[0-9]{5,5}$"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            },
