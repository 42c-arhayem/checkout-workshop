# Environment variables for GraphQL server
# Copy this file to the parent app directory if not already configured

# Database
MONGODB_URI=mongodb://localhost:27017/42c-banking

# JWT Token Configuration
TOKEN_USER_ACCESS_SECRET=your_secret_key_change_this_in_production
TOKEN_USER_ACCESS_EXPIRY=3600

# TLS Configuration
TLS_PASSPHRASE=your_tls_passphrase

# Server Ports
PORT=3000
GRAPHQL_PORT=4000

# Node Environment
NODE_ENV=development
