{
	"info": {
		"_postman_id": "graphql-42c-banking",
		"name": "42C Banking GraphQL API",
		"description": "Complete GraphQL API collection for 42c Banking with authentication, account management, payments, and product operations. Includes vulnerability testing examples.\n\nSetup:\n1. Import this collection\n2. Import the environment file\n3. Run 'Register' or 'Login' to get a token\n4. Token is automatically saved to environment\n5. All subsequent requests use the token automatically",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register - Current Account",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.register) {",
									"        pm.environment.set('accountId', jsonData.data.register.accountId);",
									"        console.log('Account ID saved:', jsonData.data.register.accountId);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "graphql",
							"graphql": {
								"query": "mutation Register($input: RegisterInput!) {\n  register(input: $input) {\n    message\n    accountId\n  }\n}",
								"variables": "{\n  \"input\": {\n    \"name\": \"John Doe\",\n    \"email\": \"john.doe@example.com\",\n    \"postalAddress\": {\n      \"addressLine\": [\"123 Main Street\", \"Apartment 4B\"],\n      \"postCode\": \"SW1A 1AA\",\n      \"country\": \"UK\"\n    },\n    \"pan\": \"1234\",\n    \"accountType\": \"current\"\n  }\n}"
							}
						},
						"url": {
							"raw": "{{baseUrl}}/graphql",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"graphql"
							]
						},
						"description": "Register a new user account with current account type."
					},
					"response": []
				},
				{
					"name": "Register - Business Account (Vulnerable)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "graphql",
							"graphql": {
								"query": "mutation Register($input: RegisterInput!) {\n  register(input: $input) {\n    message\n    accountId\n  }\n}",
								"variables": "{\n  \"input\": {\n    \"name\": \"Business Corp\",\n    \"email\": \"business@example.com\",\n    \"postalAddress\": {\n      \"addressLine\": [\"456 Corporate Blvd\"],\n      \"postCode\": \"10001\",\n      \"country\": \"US\"\n    },\n    \"pan\": \"5678\",\n    \"accountType\": \"business\"\n  }\n}"
							}
						},
						"url": {
							"raw": "{{baseUrl}}/graphql",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"graphql"
							]
						},
						"description": "**VULNERABILITY**: Privilege Escalation (OWASP API1:2023)\n\nAllows registering with business account type, granting higher overdraft limit (10000 vs 500)."
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.login) {",
									"        pm.environment.set('authToken', jsonData.data.login.access);",
									"        console.log('Auth token saved to environment');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "graphql",
							"graphql": {
								"query": "mutation Login($input: LoginInput!) {\n  login(input: $input) {\n    access\n    access_expires\n  }\n}",
								"variables": "{\n  \"input\": {\n    \"email\": \"john.doe@example.com\",\n    \"pan\": \"1234\"\n  }\n}"
							}
						},
						"url": {
							"raw": "{{baseUrl}}/graphql",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"graphql"
							]
						},
						"description": "Login to get an access token. Token is automatically saved to environment variable."
					},
					"response": []
				},
				{
					"name": "Login - DOS Attack (Vulnerable)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "graphql",
							"graphql": {
								"query": "mutation Login($input: LoginInput!) {\n  login(input: $input) {\n    access\n  }\n}",
								"variables": "{\n  \"input\": {\n    \"email\": \"victim@example.com\",\n    \"pan\": \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"\n  }\n}"
							}
						},
						"url": {
							"raw": "{{baseUrl}}/graphql",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"graphql"
							]
						},
						"description": "**VULNERABILITY**: Broken Authentication (OWASP API2:2023)\n\nSending extremely long password overwhelms bcrypt hashing, causing denial of service."
					},
					"response": []
